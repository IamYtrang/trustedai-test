# Copy to .env and fill in your key.
OPENAI_API_KEY=
# Optional overrides (defaults shown):
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# MAX_AGENT_TOOL_TURNS=6
# LOGS_DIR=data/chat_logs
# USD per 1M tokens, used for per-message cost estimates (gpt-4o-mini defaults).
# Update when changing OPENAI_MODEL; set to "none" to disable cost estimation.
# LLM_PRICE_INPUT_PER_1M=0.15
# LLM_PRICE_CACHED_INPUT_PER_1M=0.075
# LLM_PRICE_OUTPUT_PER_1M=0.60
